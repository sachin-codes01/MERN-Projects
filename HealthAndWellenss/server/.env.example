# Server kis port pe chalega
PORT=5000

# MongoDB Compass wala local connection string + database ka naam
MONGO_URI=mongodb://127.0.0.1:27017/health_wellness

# Frontend ka URL (CORS ke liye) — kai ho to comma se
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Login tokens sign karne ki secret key — lambi random string rakho
# Banane ke liye: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# true = OTP SMS ki jagah console + screen pe (jab tak SMS provider nahi lagta)
OTP_DEV_MODE=true

# "npm run seed" pehla admin account inhi se banata hai
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# npx nodemon src/index.js