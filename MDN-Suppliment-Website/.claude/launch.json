{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "server-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start",
        "--prefix",
        "server"
      ],
      "port": 5000
    },
    {
      "name": "client-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client",
        "--",
        "--host",
        "--port",
        "5180",
        "--mode",
        "phone"
      ],
      "port": 5180
    },
    {
      "name": "server-test",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "cwd": "server",
      "env": {
        "PORT": "5055"
      },
      "port": 5055
    },
    {
      "name": "client-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "env": {
        "VITE_BASE_URL": "http://localhost:5055/api"
      },
      "port": 5190
    }
  ]
}